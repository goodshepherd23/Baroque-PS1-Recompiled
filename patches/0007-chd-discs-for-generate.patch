     return EXIT_OK
 
 
+def unpack_chd(
+    project_root: Path,
+    chd: Path,
+    out_dir: Path,
+    cue_name: str,
+    progress: ProgressReporter,
+) -> Path:
+    """Unpack a CD .chd to a Redump-style .cue + "(Track N).bin" set in out_dir.
+
+    The rest of generate (digest check, prepare_disc, boot EXE) then works on
+    that set exactly as on a .cue/.bin dump. psxrecomp-chd2cue reads through the
+    runtime's ISOReader and is built from recompiler/ on first use.
+    """
+    try:
+        tool = _find_recompiler_tool(project_root, "psxrecomp-chd2cue", "PSXRECOMP_CHD2CUE")
+    except FileNotFoundError:
+        progress.log("Building psxrecomp-chd2cue (reads .chd discs)...")
+        _build_recompiler_targets(project_root, progress, ("psxrecomp-chd2cue",))
+        tool = _find_recompiler_tool(project_root, "psxrecomp-chd2cue", "PSXRECOMP_CHD2CUE")
+    progress.phase("unpack_chd", pct=0.06, message=f"Unpacking {chd.name}")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    proc = subprocess.run(
+        [str(tool), str(chd), str(out_dir), cue_name],
+        cwd=str(project_root), capture_output=True, text=True,
+        encoding="utf-8", errors="replace",
+    )
+    out = (proc.stdout or "") + (proc.stderr or "")
+    cue = None
+    for line in out.splitlines():
+        if line.startswith("RESULT_CUE="):
+            cue = Path(line[len("RESULT_CUE="):].strip())
+        elif line.strip():
+            progress.log(line)
+    if proc.returncode != 0 or not cue or not cue.is_file():
+        raise RuntimeError(f"could not unpack {chd.name} (psxrecomp-chd2cue exit {proc.returncode})")
+    return cue.resolve()
+
+
