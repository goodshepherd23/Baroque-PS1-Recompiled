@@ -4426,10 +4426,121 @@ static void host_selfcheck_or_return(const PsxrecompCodegenHostConfig* cfg,
     exit(missing ? 2 : 0);
 }
 
+/* --prepare --game <cue>: the setup wizard's "Generate & rebuild" without a
+ * window, for launchers that run a setup step themselves (RecompLauncher's
+ * "prepare"). It calls the same steps the wizard does -- portable toolchain,
+ * generate from the player's disc (which also records the disc for the game),
+ * then the rebuild -- and prints "progress <0..1> <text>" lines on stdout.
+ * Exit 0 when the product exe is built, 1 on failure (reason on stderr).
+ * Without --prepare nothing changes. On Windows the rebuild runs here instead
+ * of through the deferred helper the wizard uses: no launcher window is open
+ * and the setup exe is not part of the build. */
+typedef struct { float lo, hi; } HostPrepareRange;
+
+static void host_prepare_cli_progress(void* ctx, float pct, const char* msg) {
+    static float s_shown = 0.0f;   /* log lines without a percentage report 0 */
+    const HostPrepareRange* r = (const HostPrepareRange*)ctx;
+    float v;
+    if (pct < 0.0f) pct = 0.0f;
+    if (pct > 1.0f) pct = 1.0f;
+    v = r->lo + (r->hi - r->lo) * pct;
+    if (v < s_shown) v = s_shown;
+    s_shown = v;
+    printf("progress %.3f %s\n", v, msg ? msg : "");
+    fflush(stdout);
+}
+
+static int host_prepare_cli_rebuild(const char* disc, char* err, size_t cap,
+                                    HostPrepareRange* r) {
+#if defined(_WIN32)
+    char cmdline[4096];
+    if (!host_ensure_toolchain(host_prepare_cli_progress, r, err, cap))
+        return 0;
+    activate_toolchain_path();
+    if (!find_python(g_python, sizeof(g_python))) {
+        snprintf(err, cap, "No usable Python for the rebuild.");
+        return 0;
+    }
+    snprintf(cmdline, sizeof(cmdline),
+             "\"%s\" \"%s\" rebuild --project-root \"%s\" --config \"%s\" "
+             "--build-dir \"%s\" --target \"%s\" --exe-basename \"%s\" "
+             "--disc \"%s\" --no-pgo --prune-after build-intermediates "
+             "--json-progress",
+             g_python, g_cli_path, g_project_root, g_game_toml, g_build_dir,
+             g_cmake_target, g_exe_basename, disc);
+    if (!run_cli_win(cmdline, host_prepare_cli_progress, r, err, cap,
+                     "psxrecomp rebuild"))
+        return 0;
+    if (!path_is_file(g_exe_path)) {
+        snprintf(err, cap, "Build succeeded but binary missing: %s", g_exe_path);
+        return 0;
+    }
+    return 1;
+#else
+    char out[1100];
+    return host_rebuild_game(disc, out, sizeof(out), err, cap,
+                             host_prepare_cli_progress, r);
+#endif
+}
+
+static void host_prepare_cli_or_return(const PsxrecompCodegenHostConfig* cfg,
+                                       int argc, char** argv) {
+    RecompLauncherCGameInfo gi;
+    HostPrepareRange r;
+    const char* disc = NULL;
+    char gen_out[1100], err[2048], disc_abs[1100];
+    int i, want = 0;
+
+    for (i = 1; i < argc && argv[i]; ++i) {
+        if (strcmp(argv[i], "--prepare") == 0)
+            want = 1;
+        else if (strcmp(argv[i], "--game") == 0 && i + 1 < argc)
+            disc = argv[++i];
+        else if (strncmp(argv[i], "--game=", 7) == 0)
+            disc = argv[i] + 7;
+    }
+    if (!want)
+        return;
+    err[0] = '\0';
+    if (!disc || !disc[0] ||
+        !absolutize_existing_file(disc_abs, sizeof(disc_abs), disc)) {
+        fprintf(stderr, "error: --prepare needs --game <your .cue or .chd>\n");
+        exit(1);
+    }
+    memset(&gi, 0, sizeof(gi));
+    psxrecomp_codegen_host_apply(&gi, cfg);
+    if (!g_ready || !resolve_build_paths()) {
+        fprintf(stderr, "error: this folder is not a complete setup package "
+                        "(project files or build tree not found)\n");
+        exit(1);
+    }
+    r.lo = 0.00f; r.hi = 0.10f;
+    host_prepare_cli_progress(&r, 0.0f, "Getting the build tools");
+    if (!host_ensure_toolchain(host_prepare_cli_progress, &r, err, sizeof(err)))
+        goto fail;
+    r.lo = 0.10f; r.hi = 0.45f;
+    host_prepare_cli_progress(&r, 0.0f, "Generating the game code from your disc");
+    if (!host_prepare_generate(disc_abs, gen_out, sizeof(gen_out), err,
+                               sizeof(err), host_prepare_cli_progress, &r))
+        goto fail;
+    r.lo = 0.45f; r.hi = 1.00f;
+    host_prepare_cli_progress(&r, 0.0f, "Building the game");
+    if (!host_prepare_cli_rebuild(disc_abs, err, sizeof(err), &r))
+        goto fail;
+    host_prepare_cli_progress(&r, 1.0f, "Ready");
+    exit(0);
+fail:
+    fprintf(stderr, "error: %s\n", err[0] ? err : "setup failed");
+    exit(1);
+}
+
 /* Setup-host zip-root exe → build-release product (bios/mods/assets/settings). */
 void psxrecomp_codegen_host_forward_if_built(
     const PsxrecompCodegenHostConfig* cfg, int argc, char** argv) {
     host_selfcheck_or_return(cfg, argc, argv); /* exits when requested */
+#if !defined(PSX_HAS_GAME_DISPATCH)
+    host_prepare_cli_or_return(cfg, argc, argv); /* exits when requested */
+#endif
 #if defined(PSX_HAS_GAME_DISPATCH)
     /* Full game binary — already the product tree. */
     (void)cfg;
